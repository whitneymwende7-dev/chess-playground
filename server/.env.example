# Copy this file to .env and fill in your real values. Never commit .env itself.

# Get this from console.anthropic.com — used by /api/coach for move commentary.
ANTHROPIC_API_KEY=your-key-here

# Local dev default (SQLite, zero setup). For deployment, swap to a MySQL URL
# and change the provider in prisma/schema.prisma to "mysql".
DATABASE_URL="file:./dev.db"

# Port the Express server listens on.
PORT=3001
